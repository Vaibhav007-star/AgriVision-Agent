# ==============================================================================
# AgriVision Agent Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Environment (development, production)
APP_ENV=development
APP_DEBUG=True
APP_PORT=8501

# Language preference: en (English) or hi (Hindi)
DEFAULT_LANGUAGE=en

# LLM Provider Configuration
# Supported: "groq", "gemini", "ollama"
LLM_PROVIDER=groq

# API Keys (Free tier available for Groq & Gemini)
# Groq: https://console.groq.com/keys (Fast & generous free tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini: https://aistudio.google.com/app/apikey (Free tier available)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama Configuration (Completely free & offline)
# Default host when running Ollama locally
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Weather API (Optional - OpenWeatherMap free tier)
# https://openweathermap.org/api
WEATHER_API_KEY=your_openweather_api_key_here
DEFAULT_LOCATION=Karnal, Haryana

# Deep Learning / Computer Vision Settings
MODEL_PATH=models/saved_models/crop_disease_model.keras
CLASS_INDICES_PATH=models/saved_models/class_indices.json
CONFIDENCE_THRESHOLD=0.60
INPUT_IMAGE_SIZE=224

# Knowledge Base / RAG Settings
RAG_DATA_DIR=data/rag_docs
FAISS_INDEX_PATH=data/processed/faiss_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage & Database
DATABASE_URL=sqlite:///data/agrivision.db

